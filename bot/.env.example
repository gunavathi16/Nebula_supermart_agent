# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Backend REST API endpoint (where the website backend runs)
API_BASE_URL=http://localhost:5000/api

# LLM Provider Configuration
# Choose one of: anthropic (recommended), openai, or google
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
# GEMINI_API_KEY=your_gemini_api_key_here

# Server & Webhook Configuration
PORT=3001
# Set WEBHOOK_URL for production deployment (e.g. https://your-domain.com).
# Leave blank for local polling mode.
WEBHOOK_URL=
WEBHOOK_PATH=/webhook
